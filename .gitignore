.venv/
__pycache__/
*.usdc
*.pyc
web/*.glb
web/_build/
debug.py
# Windows/WSL alternate data streams
*:Zone.Identifier

# Windows Explorer thumbnail caches, which ride along in submitted photo folders
Thumbs.db
Thumbs.db:encryptable

# Office temp/lock files
~$*


# Playwright artifacts (traces/screenshots from a failed e2e run)
app/test-results/
app/playwright-report/

# Throwaway benches the Playwright specs create (`e2e-<kind>-<timestamp>`). A
# spec deletes its own only when it passes, so a failed run leaves one behind,
# and `git add -A` -- by hand or the autosave's `git add -A -- projects/` --
# would commit it as if it were a team's project.
projects/e2e-*/

# Generated locally by setup_projects.py -- not part of the published source.
components/
projects/
