cff-version: 1.2.0
# CFF 1.2.0 has no per-author contribution field, so the equal-contribution
# statement rides along in `message` -- GitHub's "Cite this repository" widget
# shows it directly above the generated APA/BibTeX.
message: >-
  If you use OpticalTwin in your research, please cite it as below.
  All four authors contributed equally to this work.
title: "OpticalTwin: a browser-based 3D viewer and editor for optical laboratory setups"
abstract: >-
  OpticalTwin is a shared, server-hosted web application for viewing, arranging,
  and discussing optical laboratory setups in 3D. Setups are stored as OpenUSD
  scenes (millimetre units, Z-up, optical axis along +X) and edited in the
  browser through a React Three Fiber client backed by a Python/Flask server.
  Its scope is layout and planning — component fit, spacing, and alignment —
  rather than optical physics simulation.
type: software
authors:
  - family-names: Kumano
    given-names: Kai
    affiliation: "Ito–Shimobaba–Wang Laboratory, Graduate School of Engineering, Chiba University"
  - family-names: Yoshino
    given-names: Kota
    affiliation: "Ito–Shimobaba–Wang Laboratory, Graduate School of Engineering, Chiba University"
  - family-names: Goto
    given-names: Masato
    affiliation: "Ito–Shimobaba–Wang Laboratory, Graduate School of Engineering, Chiba University"
  - family-names: Matsuo
    given-names: Yuto
    affiliation: "Ito–Shimobaba–Wang Laboratory, Graduate School of Engineering, Chiba University"
license: Apache-2.0
repository-code: "https://github.com/itotlab-system/opticaltwin-core"
url: "https://github.com/itotlab-system/opticaltwin-core"
version: 1.0.0
date-released: 2026-07-26
keywords:
  - optics
  - optical setup
  - laboratory automation
  - OpenUSD
  - digital twin
  - 3D visualization
  - React Three Fiber
# Zenodo concept DOI -- always resolves to the newest version. Leave this one in
# place across releases; each version also gets its own DOI (v1.0.0 is
# 10.5281/zenodo.21594828) which is only needed to pin an exact version.
doi: 10.5281/zenodo.21594827

# ---------------------------------------------------------------------------
# When a paper about OpticalTwin is published, fill this in and uncomment it.
# GitHub's "Cite this repository" button then offers the paper's APA/BibTeX
# instead of the software's, while everything above stays as the record of the
# software itself. Also change `message:` to point at the paper.
#
# Citation counts are NEVER transferred between DOIs: the citations already on
# the Zenodo DOI stay there and the paper starts its own tally. To keep the two
# linked, cite the concept DOI from inside the paper and add the paper's DOI to
# the Zenodo record as a related identifier (IsDescribedBy / IsSupplementTo).
# `python scripts/citations.py --total <paper-doi>` sums them locally.
#
# preferred-citation:
#   type: article
#   title: "..."
#   authors:
#     - family-names: Kumano
#       given-names: Kai
#       affiliation: "Ito–Shimobaba–Wang Laboratory, Graduate School of Engineering, Chiba University"
#   journal: "..."
#   year: 2027
#   doi: 10.xxxx/xxxxx
# ---------------------------------------------------------------------------
